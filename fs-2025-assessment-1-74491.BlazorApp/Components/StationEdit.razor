@page "/stations/{number:int}/edit"
@rendermode InteractiveServer

@using fs_2025_assessment_1_74491.BlazorApp.Models
@using fs_2025_assessment_1_74491.BlazorApp.Services

@inject StationsApiClient Api
@inject NavigationManager Nav

<h3>Edit Station</h3>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}
else if (station == null)
{
    <p>Station not found.</p>
}
else
{
    <EditForm Model="station" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Number</label>
            <InputNumber class="form-control" @bind-Value="station.number" disabled />
        </div>

        <div class="mb-3">
            <label class="form-label">Name</label>
            <InputText class="form-control" @bind-Value="station.name" />
        </div>

        <div class="mb-3">
            <label class="form-label">Address</label>
            <InputText class="form-control" @bind-Value="station.address" />
        </div>

        <div class="mb-3">
            <label class="form-label">Contract</label>
            <InputText class="form-control" @bind-Value="station.contract_name" />
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label class="form-label">Status</label>
                    <InputSelect class="form-select" @bind-Value="station.status">
                        <option value="">Unknown</option>
                        <option value="OPEN">OPEN</option>
                        <option value="CLOSED">CLOSED</option>
                    </InputSelect>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label class="form-label">Total stands</label>
                    <InputNumber class="form-control" @bind-Value="station.bike_stands" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label class="form-label">Available bikes</label>
                    <InputNumber class="form-control" @bind-Value="station.available_bikes" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label class="form-label">Available stands</label>
                    <InputNumber class="form-control" @bind-Value="station.available_bike_stands" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-check mb-3 mt-4">
                    <InputCheckbox class="form-check-input" @bind-Value="station.banking" />
                    <label class="form-check-label">Banking</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-check mb-3 mt-4">
                    <InputCheckbox class="form-check-input" @bind-Value="station.bonus" />
                    <label class="form-check-label">Bonus</label>
                </div>
            </div>
        </div>

        <h5 class="h6 mt-3">Position</h5>
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label">Latitude</label>
                    <InputNumber class="form-control" @bind-Value="station.position!.lat" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label">Longitude</label>
                    <InputNumber class="form-control" @bind-Value="station.position!.lng" />
                </div>
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                @(isSaving ? "Saving..." : "Save changes")
            </button>
            <button type="button" class="btn btn-secondary" @onclick="GoBack">
                Cancel
            </button>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int number { get; set; }

    StationDto? station;
    bool isLoading;
    bool isSaving;
    string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadStationAsync();
    }

    async Task LoadStationAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            station = await Api.GetStationAsync(number);

            if (station != null && station.position == null)
            {
                station.position = new PositionDto();
            }
        }
        catch
        {
            errorMessage = "Unable to load station for editing right now.";
            station = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    async Task HandleValidSubmit()
    {
        if (station == null || isSaving)
            return;

        isSaving = true;
        errorMessage = null;

        try
        {
            var updated = await Api.UpdateStationAsync(number, station);
            if (updated == null)
            {
                errorMessage = "Unable to save changes.";
                isSaving = false;
                return;
            }

            Nav.NavigateTo($"/stations/{number}");
        }
        catch
        {
            errorMessage = "Unable to save changes right now. Please try again.";
            isSaving = false;
        }
    }

    void GoBack()
    {
        Nav.NavigateTo($"/stations/{number}");
    }
}
