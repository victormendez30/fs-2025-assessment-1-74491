@page "/stations"
@rendermode InteractiveServer

@using fs_2025_assessment_1_74491.BlazorApp.Models
@using fs_2025_assessment_1_74491.BlazorApp.Services

@inject StationsApiClient Api

<h3>Stations</h3>

<div class="mb-3 d-flex justify-content-between align-items-center">
    <div></div>
    <a class="btn btn-primary btn-sm" href="/stations/create">
        New station
    </a>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

@if (summary != null)
{
    <div class="row mb-3 g-2">
        <div class="col-sm-6 col-md-3">
            <div class="summary-card">
                <div class="card-body">
                    <div class="fw-semibold">Total stations</div>
                    <div class="fs-4">@summary.totalStations</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="summary-card">
                <div class="card-body">
                    <div class="fw-semibold">Open stations</div>
                    <div class="fs-4">@summary.openStations</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="summary-card">
                <div class="card-body">
                    <div class="fw-semibold">Closed stations</div>
                    <div class="fs-4">@summary.closedStations</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="summary-card">
                <div class="card-body">
                    <div class="fw-semibold">Total bikes available</div>
                    <div class="fs-4">@summary.totalAvailableBikes</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="mb-3 filter-box">
    <div class="row g-2">
        <div class="col-md-3">
            <input class="form-control"
                   placeholder="Search name or address"
                   @bind="searchTerm" />
        </div>
        <div class="col-md-2">
            <select class="form-select" @bind="statusFilter">
                <option value="">All statuses</option>
                <option value="OPEN">Open</option>
                <option value="CLOSED">Closed</option>
            </select>
        </div>
        <div class="col-md-2">
            <input type="number"
                   class="form-control"
                   placeholder="Min bikes"
                   @bind="minBikes" />
        </div>
        <div class="col-md-2">
            <select class="form-select" @bind="sortBy">
                <option value="">Sort by name</option>
                <option value="availableBikes">Available bikes</option>
                <option value="bikeStands">Bike stands</option>
            </select>
        </div>
        <div class="col-md-2">
            <select class="form-select" @bind="sortDir">
                <option value="asc">Ascending</option>
                <option value="desc">Descending</option>
            </select>
        </div>
        <div class="col-md-1 d-grid gap-1">
            <button class="btn btn-primary" @onclick="ApplyFilters">
                Apply
            </button>
            <button class="btn btn-outline-secondary" @onclick="ClearFilters">
                Clear
            </button>
        </div>

    </div>
</div>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (stations == null || stations.Count == 0)
{
    <p>No stations found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Number</th>
                <th>Name</th>
                <th>Address</th>
                <th>Bikes</th>
                <th>Stands</th>
                <th>Occupancy</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in stations)
            {
                <tr>
                    <td>@s.number</td>
                    <td>
                        <a href="/stations/@s.number" class="station-link">@s.name</a>
                    </td>
                    <td>@s.address</td>
                    <td>@s.available_bikes</td>
                    <td>@s.bike_stands</td>
                    <td>
                        @{
                            var percent = s.bike_stands > 0
                            ? (int)Math.Round((double)s.available_bikes / s.bike_stands * 100) : 0;
                        }
                        <div class="small-occupancy">
                            <div class="small-occupancy-track">
                                <div class="small-occupancy-bar" style="width:@percent%"></div>
                            </div>
                            <span class="small-occupancy-label">@percent%</span>
                        </div>
                    </td>
                    <td>@s.status</td>

                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center">
        <div>
            <button class="btn btn-outline-secondary me-2"
                    disabled="@(!CanGoPrevious)"
                    @onclick="PreviousPage">
                Previous
            </button>
            <button class="btn btn-outline-secondary"
                    disabled="@(!CanGoNext)"
                    @onclick="NextPage">
                Next
            </button>
        </div>
        <div>
            Page @currentPage
        </div>
    </div>
}

@code {
    List<StationDto>? stations;
    StationSummaryDto? summary;

    bool isLoading;
    string? errorMessage;

    string? statusFilter;
    int? minBikes;
    string? searchTerm;
    string? sortBy;
    string sortDir = "asc";

    int currentPage = 1;
    int pageSize = 20;

    bool CanGoPrevious => currentPage > 1;
    bool CanGoNext => stations != null && stations.Count == pageSize;

    protected override async Task OnInitializedAsync()
    {
        await LoadSummaryAsync();
        await LoadStationsAsync();
    }

    async Task LoadSummaryAsync()
    {
        try
        {
            summary = await Api.GetSummaryAsync();
        }
        catch
        {
            summary = null;
        }
    }

    async Task LoadStationsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            stations = await Api.GetStationsAsync(
                status: statusFilter,
                minBikes: minBikes,
                search: searchTerm,
                sortBy: sortBy,
                sortDir: sortDir,
                page: currentPage,
                pageSize: pageSize);
        }
        catch
        {
            stations = new List<StationDto>();
            errorMessage = "Unable to load stations right now. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadStationsAsync();
    }

    async Task ClearFilters()
    {
        searchTerm = null;
        statusFilter = null;
        minBikes = null;
        sortBy = null;
        sortDir = "asc";
        currentPage = 1;

        await LoadStationsAsync();
    }


    async Task NextPage()
    {
        if (!CanGoNext)
            return;

        currentPage++;
        await LoadStationsAsync();
    }

    async Task PreviousPage()
    {
        if (!CanGoPrevious)
            return;

        currentPage--;
        await LoadStationsAsync();
    }
}
