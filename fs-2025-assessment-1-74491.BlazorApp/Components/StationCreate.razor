@page "/stations/create"
@rendermode InteractiveServer

@using fs_2025_assessment_1_74491.BlazorApp.Models
@using fs_2025_assessment_1_74491.BlazorApp.Services

@inject StationsApiClient Api
@inject NavigationManager Nav

<h3>Create Station</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

<EditForm Model="station" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Number</label>
        <InputNumber class="form-control" @bind-Value="station.number" />
    </div>

    <div class="mb-3">
        <label class="form-label">Name</label>
        <InputText class="form-control" @bind-Value="station.name" />
    </div>

    <div class="mb-3">
        <label class="form-label">Address</label>
        <InputText class="form-control" @bind-Value="station.address" />
    </div>

    <div class="mb-3">
        <label class="form-label">Contract</label>
        <InputText class="form-control" @bind-Value="station.contract_name" />
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="mb-3">
                <label class="form-label">Status</label>
                <InputSelect class="form-select" @bind-Value="station.status">
                    <option value="">Unknown</option>
                    <option value="OPEN">OPEN</option>
                    <option value="CLOSED">CLOSED</option>
                </InputSelect>
            </div>
        </div>
        <div class="col-md-4">
            <div class="mb-3">
                <label class="form-label">Total stands</label>
                <InputNumber class="form-control" @bind-Value="station.bike_stands" />
            </div>
        </div>
        <div class="col-md-4">
            <div class="mb-3">
                <label class="form-label">Available bikes</label>
                <InputNumber class="form-control" @bind-Value="station.available_bikes" />
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="mb-3">
                <label class="form-label">Available stands</label>
                <InputNumber class="form-control" @bind-Value="station.available_bike_stands" />
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-check mb-3 mt-4">
                <InputCheckbox class="form-check-input" @bind-Value="station.banking" />
                <label class="form-check-label">Banking</label>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-check mb-3 mt-4">
                <InputCheckbox class="form-check-input" @bind-Value="station.bonus" />
                <label class="form-check-label">Bonus</label>
            </div>
        </div>
    </div>

    <h5 class="h6 mt-3">Position</h5>
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label class="form-label">Latitude</label>
                <InputNumber class="form-control" @bind-Value="station.position!.lat" />
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label class="form-label">Longitude</label>
                <InputNumber class="form-control" @bind-Value="station.position!.lng" />
            </div>
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary" disabled="@isSaving">
            @(isSaving ? "Creating..." : "Create station")
        </button>
        <button type="button" class="btn btn-secondary" @onclick="GoBack">
            Cancel
        </button>
    </div>
</EditForm>

@code {
    StationDto station = new StationDto
    {
        contract_name = "Dublin",
        status = "OPEN",
        position = new PositionDto()
    };

    bool isSaving;
    string? errorMessage;

    async Task HandleValidSubmit()
    {
        if (isSaving)
            return;

        if (station.bike_stands < 0 || station.available_bikes < 0 || station.available_bike_stands < 0)
        {
            errorMessage = "Values cannot be negative.";
            return;
        }

        if (station.available_bikes + station.available_bike_stands != station.bike_stands)
        {
            errorMessage = "available_bikes + available_bike_stands must equal bike_stands.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        station.last_update = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        station.last_update_utc = DateTime.UtcNow.ToString("u");
        station.last_update_local = DateTime.Now.ToString("g");

        try
        {
            var created = await Api.CreateStationAsync(station);
            if (created == null)
            {
                errorMessage = "Unable to create station.";
                isSaving = false;
                return;
            }

            Nav.NavigateTo($"/stations/{created.number}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to create station: {ex.Message}";
            isSaving = false;
        }
    }

    void GoBack()
    {
        Nav.NavigateTo("/stations");
    }
}
